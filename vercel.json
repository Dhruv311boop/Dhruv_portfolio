{
  "installCommand": "corepack enable && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "node scripts/vercel-build.mjs || node ../../scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
